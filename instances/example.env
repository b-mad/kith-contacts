# Template for an instance env file. Normally generated by:
#   make instance NAME=dev PORT=5180 ENV=development
# Copy to instances/<name>.env only if you create the database yourself.
# Real env files contain credentials and are git-ignored.

INSTANCE_NAME=Dev
APP_ENV=development            # development | production | test
INSTANCE_COLOR=#bf3989         # header color (I-03)
PORT=5180
DATABASE_URL=postgresql://contacts_dev_app:CHANGE_ME@localhost:5432/contacts_dev
BACKUP_DIR=~/ContactsBackups/dev
CONTACT_TYPES=Employee,Customer,Vendor
PHONE_REGION=US                # default country for numbers typed without +code
# HOME_COMPANY=Acme Health    # optional: default company for new employees (else inferred)
# BACKUP_RETENTION_DAYS=14       # days of backups to keep (ADR-0011)
# BACKUP_TOOL=auto               # auto | local | docker
# AUTO_BACKUP=true               # default: on in production only
# SEMANTIC_SEARCH=auto           # search by meaning: auto (on when `make model` was run) | off
# MODEL_DIR=~/.cache/contacts-app/models/all-MiniLM-L6-v2
